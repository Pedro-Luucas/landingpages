# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/dist

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep .env.example
.env*
!.env.example

# python
.venv
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated / local studio data (never commit real business records)
data/studios/**
!data/studios/.gitkeep
!data/studios/**/
!data/studios/**/studio.json
!data/studios/**/dossier.json
!data/studios/**/generated.json
!data/studios/**/approved.json
!data/studios/**/deployment.json
data/state/**
!data/state/.gitkeep
!data/state/pipeline.json
!data/state/locks/
!data/state/locks/.gitkeep
data/logs/**
!data/logs/.gitkeep
data/source/**
!data/source/.gitkeep
estudios_musica.json

# downloaded studio assets
public/studios/**
!public/studios/.gitkeep
